<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer soft halo ring -->
    <path
        android:pathData="M54,54m-28,0a28,28 0 1,0 56,0a28,28 0 1,0 -56,0"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#99D946EF" android:offset="0.0" />
                <item android:color="#448B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tilted futuristic orbital ellipse 1 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="35">
        <path
            android:pathData="M30,54 A24,10 0 1,0 78,54 A24,10 0 1,0 30,54"
            android:strokeWidth="2.2">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="30"
                    android:startY="44"
                    android:endX="78"
                    android:endY="64"
                    android:type="linear">
                    <item android:color="#FF00F5FF" android:offset="0.0" />
                    <item android:color="#FFD946EF" android:offset="0.6" />
                    <item android:color="#FFA855F7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Tilted futuristic orbital ellipse 2 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-35">
        <path
            android:pathData="M30,54 A24,10 0 1,0 78,54 A24,10 0 1,0 30,54"
            android:strokeWidth="1.8">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="30"
                    android:startY="64"
                    android:endX="78"
                    android:endY="44"
                    android:type="linear">
                    <item android:color="#FFE879F9" android:offset="0.0" />
                    <item android:color="#FF818CF8" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Central Glowing Core Sphere -->
    <path
        android:pathData="M54,54m-16,0a16,16 0 1,0 32,0a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50"
                android:centerY="48"
                android:gradientRadius="18"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFE879F9" android:offset="0.3" />
                <item android:color="#FFC026D3" android:offset="0.7" />
                <item android:color="#FF7C3AED" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Specular Highlight -->
    <path
        android:pathData="M50,48m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
        android:fillColor="#CCFFFFFF" />

    <!-- Wave bars / Voice harmonic markers in the core -->
    <path
        android:pathData="M48,51 L48,57 M51,47 L51,61 M54,44 L54,64 M57,47 L57,61 M60,51 L60,57"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />
</vector>
